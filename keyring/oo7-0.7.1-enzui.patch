index bf41987..318932b 100644
--- a/server/src/plasma/prompter.rs
+++ b/server/src/plasma/prompter.rs
@@ -31,6 +31,35 @@ pub enum CallbackAction {
     Keep = 1,
 }
 
+pub(crate) const ENZUI_PROMPTER: &str = "dev.enzui.SecretPrompter";
+
+pub(crate) async fn in_enzui_environment(connection: &zbus::Connection) -> bool {
+    let Ok(unit) = zbus::Proxy::new(
+        connection,
+        "org.freedesktop.systemd1",
+        "/org/freedesktop/systemd1/unit/enzui_2dsession_2etarget",
+        "org.freedesktop.systemd1.Unit",
+    )
+    .await
+    else {
+        return false;
+    };
+    // The user service may start during PAM, before the desktop exports its environment.
+    if !unit
+        .get_property::<String>("ActiveState")
+        .await
+        .is_ok_and(|state| matches!(state.as_str(), "active" | "activating"))
+    {
+        return false;
+    }
+    let Ok(bus) = zbus::fdo::DBusProxy::new(connection).await else {
+        return false;
+    };
+    bus.list_activatable_names()
+        .await
+        .is_ok_and(|names| names.iter().any(|name| name.as_str() == ENZUI_PROMPTER))
+}
+
