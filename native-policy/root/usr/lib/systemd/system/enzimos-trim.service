# SPDX-License-Identifier: MIT
[Unit]
Description=Trim only the owned enzimOS Btrfs filesystem
[Service]
Type=oneshot
ExecStart=/usr/lib/enzimos/defer-while-gaming /usr/lib/enzimos-native/enzimos-policy maintenance trim
# Defer only contention before a maintenance command starts.
Restart=no
RestartForceExitStatus=75
RestartMode=direct
RestartSec=15min
