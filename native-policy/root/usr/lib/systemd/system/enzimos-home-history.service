# SPDX-License-Identifier: MIT
[Unit]
Description=enzimOS independent home history
ConditionPathExists=!/var/lib/enzimos-control/home-history.disabled
[Service]
Type=oneshot
# Make room first (oldest history goes when free space is below the floor);
# skip this snapshot when there is still no room. While the operation lock is
# held the guard removes nothing and the run below retries.
ExecCondition=/usr/lib/enzimos-native/enzimos-history guard
ExecStart=/usr/lib/enzimos-native/enzimos-policy home-history create-auto
# Drop build output, caches and excluded folders from the new snapshot.
ExecStartPost=-/usr/lib/enzimos-native/enzimos-history prune
# A backup or another operation holding the operation lock skips the run with
# exit 75, which runs it again 5 minutes later; the unit waits in auto-restart
# and never enters the failed state (SuccessExitStatus=75 would stop the retry).
Restart=no
RestartForceExitStatus=75
RestartMode=direct
RestartSec=5min
StateDirectory=enzimos-history
StateDirectoryMode=0700
UMask=0077
