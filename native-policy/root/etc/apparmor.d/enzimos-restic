  include <abstractions/base>
  /usr/bin/restic mrix,
  /etc/{passwd,group,nsswitch.conf,machine-id} r,
  owner @{PROC}/@{pid}/{cgroup,mountinfo} r,
  /backup-repository/ r,
  /backup-repository/** rwk,
  /restore-target/ rw,
  /restore-target/** rwkl,
  /run/enzimos/ rw,
  /run/enzimos/** rwk,
  /etc/enzimos/backup.password r,
  /sys/kernel/mm/transparent_hugepage/hpage_pmd_size r,
  capability chown,
  capability fowner,
  capability fsetid,
  capability setfcap,
  capability dac_read_search,
  capability dac_override,
  audit deny network,
  audit deny /etc/shadow rw,
  deny /root/** rwklx,
}

