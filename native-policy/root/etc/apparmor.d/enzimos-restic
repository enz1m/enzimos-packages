# Native backup uses the same fixed, read-only source and credential exclusions
# as its retained-descriptor consumer profile. No fallback to a broader role.
profile enzimos-restic-native-backup flags=(attach_disconnected) {
  include <abstractions/base>
  /usr/bin/restic mrix,
  /etc/{passwd,group,nsswitch.conf,machine-id} r,
  owner @{PROC}/@{pid}/{cgroup,mountinfo} r,
  /backup-source/ r,
  /backup-source/** r,
  /backup-repository/ r,
  /backup-repository/** rwk,
  /run/enzimos/backup-native/jobs/*/scratch/ rw,
  /run/enzimos/backup-native/jobs/*/scratch/** rwk,
  /etc/enzimos/backup.password r,
  /sys/kernel/mm/transparent_hugepage/hpage_pmd_size r,
  capability dac_override,
  audit deny network,
  audit deny /etc/shadow r,
  deny /backup-source/** wklx,
  deny /backup-source/system/etc/enzimos/backup{.,.next-,.rotation-,.retired-}password r,
  deny /backup-source/system/etc/enzimos/backup{-remote,-remote-rotation,-remote-retired}.{password,identity,hosts,json} r,
  deny /backup-source/system/etc/enzimos/backup.json r,
  deny /backup-source/system/etc/pacman.d/gnupg/** r,
  deny /backup-source/system/var/lib/enzimos-control/** r,
  deny /restore-target/** rwklx,
  deny /root/** rwklx,
  deny /etc/enzimos/backup.next-password r,
  deny /etc/enzimos/backup.{rotation-password,retired-password} r,
  deny /etc/enzimos/backup{-remote,-remote-rotation,-remote-retired}.password r,
}

