profile enzimos-restic-input-check flags=(attach_disconnected) {
  include <abstractions/base>
  /usr/bin/restic mrix,
  /etc/{passwd,group,nsswitch.conf,machine-id} r,
  owner @{PROC}/@{pid}/{cgroup,mountinfo} r,
  /backup-repository/ r,
  /backup-repository/** r,
  /run/enzimos/backup-auth-input-*/password r,
  /sys/kernel/mm/transparent_hugepage/hpage_pmd_size r,
  capability dac_read_search,
  capability dac_override,
  audit deny network,
  audit deny /etc/shadow r,
  deny /etc/enzimos/backup*.password r,
  deny /backup-source/** rwklx,
  deny /restore-target/** rwklx,
  deny /root/** rwklx,
}

