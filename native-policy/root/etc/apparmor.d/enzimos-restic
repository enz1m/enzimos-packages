  /etc/enzimos/backup.retired-password r,
  /sys/kernel/mm/transparent_hugepage/hpage_pmd_size r,
  capability dac_read_search,
  capability dac_override,
  audit deny network,
  audit deny /etc/shadow r,
  deny /backup-source/** rwklx,
  deny /restore-target/** rwklx,
  deny /root/** rwklx,
}

# NAS (SMB share) copies use separate enzimos-restic-native-remote-* profiles:
# the share is mounted by kernel CIFS in the Restic child's private namespace
# at /backup-remote before the child loses its network namespace.
