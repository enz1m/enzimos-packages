# SPDX-License-Identifier: MIT
# Prebuilt Rust binaries only; no install hook or service activation.
pkgname=enzimos-rust-packages
pkgver=0.2.1
pkgrel=3
pkgdesc='enzimOS native runtime binaries'
arch=('x86_64')
license=('MIT')
depends=('glibc' 'gcc-libs' 'openssl' 'libarchive' 'util-linux' 'btrfs-progs' 'restic' 'pacman' 'gnupg' 'systemd' 'networkmanager' 'polkit' 'dbus-broker-units' 'snapper' 'openssh' 'kmod' 'cairo' 'pango' 'ttf-dejavu' 'earlyoom')
source=('runtime.tar' 'LICENSE')
sha256sums=('@RUNTIME_SHA256@' '@LICENSE_SHA256@')
package() {
  cp -r --preserve=mode,timestamps --no-preserve=ownership "$srcdir/runtime/." "$pkgdir/"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
