[Unit]
Description=enzimOS system settings backend (D-Bus activated)
After=dbus.service polkit.service
Requires=dbus.service polkit.service

[Service]
Type=dbus
BusName=org.enzimos.System1
ExecStart=/usr/lib/enzimos-backend/enzimos-system-backend
User=root
Group=root
UMask=0077
# Backup workers enter their required AppArmor profile at exec.
Environment=PATH=/usr/bin LANG=C.UTF-8 HOME=/nonexistent
TimeoutStartSec=30
TimeoutStopSec=10
Restart=no
LimitCORE=0
LimitNOFILE=16384
MemoryMax=768M
TasksMax=64
# No private mount namespace: Snapper must see the initial system namespace.
# D-Bus starts the service on demand.
