# SPDX-License-Identifier: MIT
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = oo7
Target = greetd
Target = enzimos-greetd
Target = enzimos-rust-packages

[Action]
Description = Restore enzimOS PAM login and keyring integration
When = PostTransaction
Exec = /usr/lib/enzimos-native/enzimos-policy desktop setup --root /
