<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN" "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <action id="com.endlessm.ParentalControls.AppFilter.ChangeOwn">
    <description>Change your own app filter</description>
    <description xml:lang="zh-Hant-TW">更改您的應用程式過濾器</description>
    <description xml:lang="zh-Hans-CN">更改您自己的应用程序过滤器</description>
    <description xml:lang="uk">Зміна власного фільтра програм</description>
    <description xml:lang="tr">Kendi uygulama süzgecini değiştir</description>
    <description xml:lang="sv">Ändra ditt eget programfilter</description>
    <description xml:lang="sl">Spremenite lastni filter programov</description>
    <description xml:lang="ru">Изменение собственного фильтра приложений</description>
    <description xml:lang="ro">Modifica filtrul aplicatiei</description>
    <description xml:lang="pt-BR">Alterar seu próprio filtro de aplicativos</description>
    <description xml:lang="pl">Zmiana własnego filtru programów</description>
    <description xml:lang="ms">Ubah penapis apl anda sendiri</description>
    <description xml:lang="kk-Cyrl">Өзіңіздің қолданба сүзгісін өзгерту</description>
    <description xml:lang="ka">შეცვალეთ თქვენი საკუთარი აპის ფილტრი</description>
    <description xml:lang="it">Modifica filtri app personali</description>
    <description xml:lang="id">Ubah filter aplikasi Anda sendiri</description>
    <description xml:lang="hu">A saját alkalmazásszűrőjének megváltoztatása</description>
    <description xml:lang="hi">स्वयं के ऐप फ़िल्टर बदलें</description>
    <description xml:lang="fr">Modifiez votre propre filtre d'application</description>
    <description xml:lang="fa">تغییر پالایهٔ کارهٔ خودتان</description>
    <description xml:lang="es">Cambiar su propio filtro de aplicaciones</description>
    <description xml:lang="de">Ihren eigenen Anwendungsfilter ändern</description>
    <description xml:lang="da">Ændr dit eget programfilter</description>
    <description xml:lang="cs">Měnit filtr vlastních aplikací</description>
    <description xml:lang="ca">Canvieu el filtre d'app propi</description>
    <description xml:lang="bg">Промяна на филтъра за програми</description>
    <description xml:lang="ar">قُم بتغيير عناصر تصفية تطبيقك</description>
    <message>Authentication is required to change your app filter.</message>
    <message xml:lang="zh-Hant-TW">需要認證才能更改您的應用程式過濾器。</message>
    <message xml:lang="zh-Hans-CN">需要认证才能更改您的应用程序过滤器。</message>
    <message xml:lang="uk">Для зміни власного фільтра програм слід пройти розпізнавання.</message>
    <message xml:lang="tr">Kendi uygulama süzgecinizi değiştirmek için kimlik doğrulanmalıdır.</message>
    <message xml:lang="sv">Autentisering krävs för att ändra ditt programfilter.</message>
    <message xml:lang="sl">Preverjanje pristnosti je potrebno za spreminjanje lastnega filtra programov.</message>
    <message xml:lang="ru">Для изменения своего фильтра приложений требуется идентификация.</message>
    <message xml:lang="ro">Pentru a schimba filtrul este necesara autentificarea</message>
    <message xml:lang="pt-BR">Autenticação é necessária para alterar seu filtro de aplicativos.</message>
    <message xml:lang="pl">Wymagane jest uwierzytelnienie, aby zmienić swój filtr programów.</message>
    <message xml:lang="ms">Pengesahihan diperlukan untuk mengubah penapis apl anda.</message>
    <message xml:lang="kk-Cyrl">Қолданба сүзгісін өзгерту үшін аутентификация қажет.</message>
    <message xml:lang="ka">თქვენი აპის ფილტრის შესაცვლელად საჭიროა ავთენტიკაცია.</message>
    <message xml:lang="it">È richiesto autenticarsi per modificare i propri filtri app.</message>
    <message xml:lang="id">Diperlukan autentikasi untuk mengubah filter aplikasi Anda.</message>
    <message xml:lang="hu">Hitelesítés szükséges az alkalmazásszűrőjének megváltoztatásához.</message>
    <message xml:lang="hi">स्वयं के ऐप फिल्टर को बदलने के लिए सत्यापन की आवश्यकता है।</message>
    <message xml:lang="fr">L'authentification est requise pour modifier votre filtre d'application.</message>
    <message xml:lang="fa">دگرگونی پالایهٔ کاره‌تان نیازمند هویت‌سنجی است.</message>
    <message xml:lang="es">Necesita autenticarse para cambiar su filtro de aplicaciones.</message>
    <message xml:lang="de">Legitimierung ist erforderlich, um Ihren Anwendungsfilter zu ändern.</message>
    <message xml:lang="da">Der kræves godkendelse for at ændre dit eget programfilter.</message>
    <message xml:lang="cs">Pro změnu vlastního filtru aplikací je vyžadováno ověření.</message>
    <message xml:lang="ca">L'autenticació és necessària per a canviar el seu filtre de l'app.</message>
    <message xml:lang="bg">За променяне на филтъра за вашите програми ви е необходима идентификация.</message>
    <message xml:lang="ar">المصادقة مطلوبة لتغيير عناصر تصفية تطبيقك.</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="com.endlessm.ParentalControls.AppFilter.ReadOwn">
    <description>Read your own app filter</description>
    <description xml:lang="zh-Hant-TW">讀取您的應用程式過濾器</description>
    <description xml:lang="zh-Hans-CN">读取您自己的应用程序过滤器</description>
    <description xml:lang="uk">Читання власного фільтра програм</description>
    <description xml:lang="tr">Kendi uygulama süzgecini oku</description>
    <description xml:lang="sv">Läs ditt eget programfilter</description>
    <description xml:lang="sl">Preberite lastni filter programov</description>
    <description xml:lang="ru">Чтение собственного фильтра приложений</description>
    <description xml:lang="ro">Citeste filtrul aplicatiei</description>
    <description xml:lang="pt-BR">Ler seu próprio filtro de aplicativos</description>
    <description xml:lang="pl">Odczytanie własnego filtru programów</description>
    <description xml:lang="ms">Baca penapis apl anda sendiri</description>
    <description xml:lang="kk-Cyrl">Өзіңіздің қолданба сүзгісін оқу</description>
    <description xml:lang="ka">წაიკითხეთ თქვენი საკუთარი აპის ფილტრი</description>
    <description xml:lang="it">Lettura dei filtri app personali</description>
    <description xml:lang="id">Baca filter aplikasi Anda sendiri</description>
    <description xml:lang="hu">A saját alkalmazásszűrőjének olvasása</description>
    <description xml:lang="hi">स्वयं के ऐप फिल्टर पढ़ें</description>
    <description xml:lang="fr">Lisez votre propre filtre d'application</description>
    <description xml:lang="fa">خواندن پالایهٔ کارهٔ خودتان</description>
    <description xml:lang="es">Leer su propio filtro de aplicaciones</description>
    <description xml:lang="de">Ihren eigenen Anwendungsfilter ansehen</description>
    <description xml:lang="da">Læs dit eget programfilter</description>
    <description xml:lang="cs">Číst filtr vlastních aplikací</description>
    <description xml:lang="ca">Llegeix el teu propi filtre d'app</description>
    <description xml:lang="bg">Прочитане на филтъра за програми</description>
    <description xml:lang="ar">اقرأ عناصر تصفية تطبيقك</description>
    <message>Authentication is required to read your app filter.</message>
    <message xml:lang="zh-Hant-TW">需要認證才能讀取您的應用程式過濾器。</message>
    <message xml:lang="zh-Hans-CN">需要认证才能读取您的应用程序过滤器。</message>
    <message xml:lang="uk">Для читання власного фільтра програм слід пройти розпізнавання.</message>
    <message xml:lang="tr">Kendi uygulama süzgecinizi okumak için kimlik doğrulanmalıdır.</message>
    <message xml:lang="sv">Autentisering krävs för att läsa ditt programfilter.</message>
    <message xml:lang="sl">Preverjanje pristnosti je potrebno za branje lastnega filtra programov.</message>
    <message xml:lang="ru">Для чтения своего фильтра приложений требуется идентификация.</message>
    <message xml:lang="pt-BR">Autenticação é necessária para ler seu filtro de aplicativos.</message>
    <message xml:lang="pl">Wymagane jest uwierzytelnienie, aby odczytać własne filtry programów.</message>
    <message xml:lang="ms">Pengesahihan diperlukan untuk membaca penapis apl anda.</message>
    <message xml:lang="kk-Cyrl">Қолданба сүзгісін оқу үшін аутентификация қажет.</message>
    <message xml:lang="ka">თქვენი აპის ფილტრის წასაკითხად საჭიროა ავთენტიკაცია.</message>
    <message xml:lang="it">È richiesto autenticarsi per leggere i propri filtri app.</message>
    <message xml:lang="id">Diperlukan autentikasi untuk membaca filter aplikasi Anda.</message>
    <message xml:lang="hu">Hitelesítés szükséges az alkalmazásszűrőjének olvasásához.</message>
    <message xml:lang="hi">स्वयं के एप फ़िल्टर को पढ़ने के लिए प्रमाणीकरण आवश्यक है।</message>
    <message xml:lang="fr">L'authentification est requise pour lire votre filtre d'application.</message>
    <message xml:lang="fa">خواندن پالایهٔ کارهٔ خودتان نیازمند هویت‌سنجی است.</message>
    <message xml:lang="es">Necesita autenticarse para leer su filtro de aplicaciones.</message>
    <message xml:lang="de">Legitimierung ist erforderlich, um Ihren Anwendungsfilter anzusehen.</message>
    <message xml:lang="da">Der kræves godkendelse for at læse dit eget programfilter.</message>
    <message xml:lang="cs">Pro čtení vlastního filtru aplikací je vyžadováno ověření.</message>
    <message xml:lang="ca">L'autenticació és necessària per a llegir el seu filtre de l'app.</message>
    <message xml:lang="bg">За четене на филтъра за вашите програми ви е необходима идентификация.</message>
    <message xml:lang="ar">المصادقة مطلوبة لقراءة عناصر تصفية تطبيقك.</message>
    <defaults>
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
  <action id="com.endlessm.ParentalControls.AppFilter.ChangeAny">
    <description>Change another user’s app filter</description>
    <description xml:lang="zh-Hant-TW">更改另一位使用者的應用程式過濾器</description>
    <description xml:lang="zh-Hans-CN">更改另一个用户的应用程序过滤器</description>
    <description xml:lang="uk">Зміна фільтра програм іншого користувача</description>
    <description xml:lang="tr">Başka kullanıcının uygulama süzgecini değiştir</description>
    <description xml:lang="sv">Ändra en annan användares programfilter</description>
    <description xml:lang="sl">Spremenite filter programov drugega uporabnika</description>
    <description xml:lang="ru">Изменение фильтра приложений другого пользователя</description>
    <description xml:lang="ro">Schimba filtrul aplicatiei a altui utilizator</description>
    <description xml:lang="pt-BR">Alterar o filtro de aplicativos de outro usuário</description>
    <description xml:lang="pl">Zmiana filtru programów innego użytkownika</description>
    <description xml:lang="ms">Ubah penapis apl pengguna lain</description>
    <description xml:lang="kk-Cyrl">Басқа пайдаланушының қолданба сүзгісін өзгерту</description>
    <description xml:lang="ka">სხვა მომხმარებლის აპის ფილტრის შეცვლა</description>
    <description xml:lang="it">Modifica dei filtri app di un altro utente</description>
    <description xml:lang="id">Ubah filter aplikasi pengguna lain</description>
    <description xml:lang="hu">Egy másik felhasználó alkalmazásszűrőjének megváltoztatása</description>
    <description xml:lang="hi">किसी अन्य उपयोगकर्ता के ऐप फ़िल्टर बदलें</description>
    <description xml:lang="fr">Modifier le filtre d'application d'un autre utilisateur</description>
    <description xml:lang="fa">تغییر پالایهٔ کارهٔ کاربری دیگر</description>
    <description xml:lang="es">Cambiar filtro de aplicaciones de otra cuenta</description>
    <description xml:lang="de">Anwendungsfilter eines anderen Nutzers ändern</description>
    <description xml:lang="da">Ændr en anden brugers programfilter</description>
    <description xml:lang="cs">Měnit filtr aplikací jiného uživatele</description>
    <description xml:lang="ca">Canvieu el filtre d'app d'un altre usuari</description>
    <description xml:lang="bg">Промяна на филтъра за програми на друг потребител</description>
    <description xml:lang="ar">قم بتغيير مرشح تطبيق مستخدم آخر</description>
    <message>Authentication is required to change another user’s app filter.</message>
    <message xml:lang="zh-Hant-TW">需要認證才能更改另一位使用者的應用程式過濾器。</message>
    <message xml:lang="zh-Hans-CN">需要认证才能更改另一个用户的应用程序过滤器。</message>
    <message xml:lang="uk">Для зміни фільтра програм іншого користувача слід пройти розпізнавання.</message>
    <message xml:lang="tr">Başka kullanıcının uygulama süzgecini değiştirmek için kimlik doğrulanmalıdır.</message>
    <message xml:lang="sv">Autentisering krävs för att ändra en annan användares programfilter.</message>
    <message xml:lang="sl">Preverjanje pristnosti je potrebno za spreminjanje filtra programov za drugega uporabnika.</message>
    <message xml:lang="ru">Для изменения фильтра приложений другого пользователя требуется идентификация.</message>
    <message xml:lang="ro">Pentru a schimba filrtul aplicatiei a altui utilizator,este necesara autentificarea.</message>
    <message xml:lang="pt-BR">Autenticação é necessária para alterar o filtro de aplicativos de outro usuário.</message>
    <message xml:lang="pl">Wymagane jest uwierzytelnienie, aby zmienić filtr programów innego użytkownika.</message>
    <message xml:lang="ms">Pengesahihan diperlukan untuk mengubah penapis apl pengguna yang lain.</message>
    <message xml:lang="kk-Cyrl">Басқа пайдаланушының қолданба сүзгісін өзгерту үшін аутентификация қажет.</message>
    <message xml:lang="ka">სხვა მომხმარებლის აპის ფილტრის შესაცვლელად ავთენტიკაციაა საჭირო.</message>
    <message xml:lang="it">È richiesto autenticarsi per modificare i filtri app di un altro utente.</message>
    <message xml:lang="id">Diperlukan autentikasi untuk mengubah filter aplikasi pengguna lain.</message>
    <message xml:lang="hu">Hitelesítés szükséges egy másik felhasználó alkalmazásszűrőjének megváltoztatásához.</message>
    <message xml:lang="hi">किसी अन्य उपयोगकर्ता के ऐप फ़िल्टर को बदलने के लिए प्रमाणीकरण की आवश्यकता है।</message>
    <message xml:lang="fr">L'authentification est requise pour modifier le filtre d'application d'un autre utilisateur.</message>
    <message xml:lang="fa">تشخیص هویت برای تغیر دادن فیلتر برنامه یوزر دیگر ضروری است.</message>
    <message xml:lang="es">Necesita autenticarse para cambiar el filtro de aplicaciones de otra cuenta.</message>
    <message xml:lang="de">Legitimierung ist erforderlich, um den Anwendungsfilter eines anderen Nutzers zu ändern.</message>
    <message xml:lang="da">Der kræves godkendelse for at ændre en anden brugers programfilter.</message>
    <message xml:lang="cs">Pro změnu filtru aplikací jiného uživatele je vyžadováno ověření.</message>
    <message xml:lang="ca">Cal autenticació per a canviar el filtre d'app d'un altre usuari.</message>
    <message xml:lang="bg">За променяне на филтъра за програми на друг потребител е необходима идентификация.</message>
    <message xml:lang="ar">المصادقة مطلوبة لتغيير عناصر تصفية التطبيق الخاص بمستخدمٍ آخر.</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="com.endlessm.ParentalControls.AppFilter.ReadAny">
    <description>Read another user’s app filter</description>
    <description xml:lang="zh-Hant-TW">讀取另一位使用者的應用程式過濾器</description>
    <description xml:lang="zh-Hans-CN">读取另一个用户的应用程序过滤器</description>
    <description xml:lang="uk">Читання фільтра програм іншого користувача</description>
    <description xml:lang="tr">Başka kullanıcının uygulama süzgecini oku</description>
    <description xml:lang="sv">Läs en annan användares programfilter</description>
    <description xml:lang="sl">Preberite filter programov drugega uporabnika</description>
    <description xml:lang="ru">Чтение фильтра приложений другого пользователя</description>
    <description xml:lang="ro">Citeste filtrul aplicatiei a altui utilizator.</description>
    <description xml:lang="pt-BR">Ler o filtro de aplicativo de outro usuário</description>
    <description xml:lang="pl">Odczytanie filtru programów innego użytkownika</description>
    <description xml:lang="ms">Baca penapis apl pengguna lain</description>
    <description xml:lang="kk-Cyrl">Басқа пайдаланушының қолданба сүзгісін оқу</description>
    <description xml:lang="ka">სხვა მომხმარებლის აპის ფილტრის წაკითხვა</description>
    <description xml:lang="it">Lettura dei filtri app di un altro utente</description>
    <description xml:lang="id">Baca filter aplikasi pengguna lain</description>
    <description xml:lang="hu">Egy másik felhasználó alkalmazásszűrőjének olvasása</description>
    <description xml:lang="hi">किसी अन्य उपयोगकर्ता के ऐप फ़िल्टर पढ़ें</description>
    <description xml:lang="fr">Lire le filtre d'application d'un autre utilisateur</description>
    <description xml:lang="fa">فیلتر برنامه کاربر دیگر را بخوانید</description>
    <description xml:lang="es">Leer el filtro de aplicaciones de otra cuenta</description>
    <description xml:lang="de">Anwendungsfilter eines anderen Nutzers ansehen</description>
    <description xml:lang="da">Læs en anden brugers programfilter</description>
    <description xml:lang="cs">Číst filtr aplikací jiného uživatele</description>
    <description xml:lang="ca">Llegeix el filtre d'app d'un altre usuari</description>
    <description xml:lang="bg">Прочитане на филтъра за програми на друг потребител</description>
    <description xml:lang="ar">قراءة مرشح تطبيقات مستخدم آخر</description>
    <message>Authentication is required to read another user’s app filter.</message>
    <message xml:lang="zh-Hant-TW">需要認證才能讀取另一位使用者的應用程式過濾器。</message>
    <message xml:lang="zh-Hans-CN">需要认证才能读取另一个用户的应用程序过滤器。</message>
    <message xml:lang="uk">Для читання фільтра програм іншого користувача слід пройти розпізнавання.</message>
    <message xml:lang="tr">Başka kullanıcının uygulama süzgecini okumak için kimlik doğrulanmalıdır.</message>
    <message xml:lang="sv">Autentisering krävs för att läsa en annan användares programfilter.</message>
    <message xml:lang="sl">Preverjanje pristnosti je potrebno za branje filtra programov drugega uporabnika.</message>
    <message xml:lang="ru">Для чтения фильтра приложений другого пользователя требуется идентификация.</message>
    <message xml:lang="ro">Pentru a citi filtrul aplicatiei a altui utilizator,este necesara autentificarea.</message>
    <message xml:lang="pt-BR">Autenticação é necessária para ler o filtro de aplicativos de outro usuário.</message>
    <message xml:lang="pl">Wymagane jest uwierzytelnienie, aby odczytać filtr programów innego użytkownika.</message>
    <message xml:lang="ms">Pengesahihan diperlukan untuk membaca penapis apl pengguna yang lain.</message>
    <message xml:lang="kk-Cyrl">Басқа пайдаланушының қолданба сүзгісін оқу үшін аутентификация қажет.</message>
    <message xml:lang="ka">სხვა მომხმარებლის აპის ფილტრის წასაკითხად ავთენტიკაციაა საჭირო.</message>
    <message xml:lang="it">È richiesto autenticarsi per leggere i filtri app di un altro utente.</message>
    <message xml:lang="id">Diperlukan autentikasi untuk membaca filter aplikasi pengguna lain.</message>
    <message xml:lang="hu">Hitelesítés szükséges egy másik felhasználó alkalmazásszűrőjének olvasásához.</message>
    <message xml:lang="hi">किसी अन्य उपयोगकर्ता के ऐप फ़िल्टर को पढ़ने के लिए सत्यापन आवश्यक है।</message>
    <message xml:lang="fr">L'authentification est requise pour lire le filtre d'application d'un autre utilisateur.</message>
    <message xml:lang="fa">نیازمند هویت‌سنجی برای خواندن پالایهٔ کارهٔ کاربری دیگر.</message>
    <message xml:lang="es">Necesita autenticarse para leer el filtro de aplicaciones de otra cuenta.</message>
    <message xml:lang="de">Legitimierung ist erforderlich, um den Anwendungsfilter eines anderen Nutzers anzusehen.</message>
    <message xml:lang="da">Der kræves godkendelse for at læse en anden brugers programfilter.</message>
    <message xml:lang="cs">Pro čtení filtru aplikací jiného uživatele je vyžadováno ověření.</message>
    <message xml:lang="ca">L'autenticació és necessària per a llegir el filtre d'app d'un altre usuari.</message>
    <message xml:lang="bg">За четене на филтъра за програми на друг потребител ви е необходима идентификация.</message>
    <message xml:lang="ar">المصادقة مطلوبة لقراءة مرشح تطبيق مستخدم آخر.</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="com.endlessm.ParentalControls.SessionLimits.ChangeOwn">
    <description>Change your own session limits</description>
    <description xml:lang="zh-Hant-TW">更改您的工作階段限制</description>
    <description xml:lang="zh-Hans-CN">更改您自己的会话限制</description>
    <description xml:lang="uk">Зміна обмежень власного сеансу</description>
    <description xml:lang="tr">Kendi oturum sınırlarını değiştir</description>
    <description xml:lang="sv">Ändra dina egna sessionsgränser</description>
    <description xml:lang="sl">Spremenite svoje omejitve sej</description>
    <description xml:lang="ru">Изменение ограничений собственного сеанса</description>
    <description xml:lang="ro">Modifica limita de sesiune personala.</description>
    <description xml:lang="pt-BR">Alterar seus próprios limites de sessão</description>
    <description xml:lang="pl">Zmiana własnych ograniczeń sesji</description>
    <description xml:lang="ms">Ubah had sesi anda sendiri</description>
    <description xml:lang="kk-Cyrl">Өзіңіздің сеанс шектеулерін өзгерту</description>
    <description xml:lang="ka">თქვენი საკუთარი სესიის ლიმიტების შეცვლა</description>
    <description xml:lang="it">Modifica dei limiti di sessione personali</description>
    <description xml:lang="id">Ubah batas sesi Anda sendiri</description>
    <description xml:lang="hu">A saját munkamenetkorlátainak megváltoztatása</description>
    <description xml:lang="hi">स्वयं की सत्र सीमा को बदलें</description>
    <description xml:lang="fr">Modifiez vos propres limites de session</description>
    <description xml:lang="fa">دگرگونی محدودیت‌های نشست خودتان</description>
    <description xml:lang="es">Cambiar sus propios límites de sesión</description>
    <description xml:lang="de">Ihre eigenen Sitzungsbeschränkungen ändern</description>
    <description xml:lang="da">Ændr dine egne sessionsgrænser</description>
    <description xml:lang="cs">Měnit limity vlastního sezení</description>
    <description xml:lang="ca">Canvieu els límits de sessió propis</description>
    <description xml:lang="bg">Промяна на ограниченията на сесията ви</description>
    <description xml:lang="ar">تغيير حدود جلستك</description>
    <message>Authentication is required to change your session limits.</message>
    <message xml:lang="zh-Hant-TW">需要認證才能更改您的工作階段限制。</message>
    <message xml:lang="zh-Hans-CN">需要认证才能更改您的会话限制。</message>
    <message xml:lang="uk">Для зміни обмежень вашого власного сеансу слід пройти розпізнавання.</message>
    <message xml:lang="tr">Kendi oturum sınırlarınızı değiştirmek için kimlik doğrulanmalıdır.</message>
    <message xml:lang="sv">Autentisering krävs för att ändra dina sessionsgränser.</message>
    <message xml:lang="sl">Preverjanje pristnosti je potrebno za spreminjanje omejitev sej.</message>
    <message xml:lang="ru">Для изменения ограничений собственного сеанса требуется идентификация.</message>
    <message xml:lang="pt-BR">Autenticação é necessária para alterar seus próprios limites de sessão.</message>
    <message xml:lang="pl">Wymagane jest uwierzytelnienie, aby zmienić własne ograniczenia sesji.</message>
    <message xml:lang="ms">Pengesahihan diperlukan untuk mengubah had sesi anda.</message>
    <message xml:lang="kk-Cyrl">Сеанс шектеулерін өзгерту үшін аутентификация қажет.</message>
    <message xml:lang="ka">თქვენი საკუთარი სესიის ლიმიტების შესაცვლელად ავთენთიკაციაა საჭირო.</message>
    <message xml:lang="it">È richiesto autenticarsi per modificare i propri limiti di sessione.</message>
    <message xml:lang="id">Diperlukan autentikasi untuk mengubah batas sesi Anda.</message>
    <message xml:lang="hu">Hitelesítés szükséges a munkamenetkorlátainak megváltoztatásához.</message>
    <message xml:lang="hi">स्वयं की सत्र सीमा को बदलने के लिए सत्यापन की आवश्यकता है।</message>
    <message xml:lang="fr">L'authentification est requise pour modifier vos limites de session.</message>
    <message xml:lang="fa">نیازمند هویت‌سنجی برای دگرگونی محدودیت‌های نشستتان.</message>
    <message xml:lang="es">Necesita autenticarse para cambiar los límites de su sesión.</message>
    <message xml:lang="de">Legitimierung ist erforderlich, um Ihre Sitzungsbeschränkungen zu ändern.</message>
    <message xml:lang="da">Der kræves godkendelse for at ændre dine egne sessionsgrænser.</message>
    <message xml:lang="cs">Pro změnu limitů vlastního sezení je vyžadováno ověření.</message>
    <message xml:lang="ca">Es requereix autenticació per a canviar els límits de sessió.</message>
    <message xml:lang="bg">За променяне на ограниченията на сесията ви е необходима идентификация.</message>
    <message xml:lang="ar">المصادقة مطلوبة لتغيير حدود جلستك.</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="com.endlessm.ParentalControls.SessionLimits.ReadOwn">
    <description>Read your own session limits</description>
    <description xml:lang="zh-Hant-TW">讀取您的工作階段限制</description>
    <description xml:lang="zh-Hans-CN">读取您自己的会话限制</description>
