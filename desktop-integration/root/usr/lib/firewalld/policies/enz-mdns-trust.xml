<policy target="CONTINUE" priority="-600">
  <short>Discovery on trusted networks</short>
  <description>Allow outgoing mDNS only on connections explicitly assigned to enzimOS's trusted zone.</description>
  <ingress-zone name="HOST"/>
  <egress-zone name="enzimos-trusted"/>
  <service name="mdns"/>
</policy>
