[Unit]
Description=enzimOS additional greeter on reserved VT5
After=systemd-user-sessions.service
ConditionPathExists=!/run/enzimos-recovery-console
Conflicts=getty@tty5.service
[Service]
ExecStart=/usr/bin/greetd --config /etc/greetd/enzimos-switch-5.toml
RuntimeDirectory=enzimos-greetd-5
RuntimeDirectoryMode=0700
Type=simple
Restart=no
KillMode=mixed
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty5
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
LimitCORE=0
