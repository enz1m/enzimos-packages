[Unit]
Description=enzimOS additional greeter on reserved VT6
After=systemd-user-sessions.service
ConditionPathExists=!/run/enzimos-recovery-console
Conflicts=getty@tty6.service
[Service]
ExecStart=/usr/bin/greetd --config /etc/greetd/enzimos-switch-6.toml
RuntimeDirectory=enzimos-greetd-6
RuntimeDirectoryMode=0700
Type=simple
Restart=no
KillMode=mixed
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty6
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
LimitCORE=0
